{
  "name": "nandee-scan-action-monorepo",
  "private": true,
  "description": "Nandee-AI Mobile Application Security Scan: GitHub Action, GitLab CI/CD component and the nandee CLI, built on one shared core.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "core",
    "cli",
    "github-action",
    "gitlab"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b core cli github-action gitlab",
    "lint": "eslint . && node scripts/check-policy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "node scripts/bundle-action.mjs",
    "check-dist": "npm run bundle && git diff --exit-code -- dist/"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
